{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "library": {
      "default": "library",
      "type": "string"
    },
    "catalog": {
      "default": "catalog",
      "type": "string"
    },
    "environment": {
      "default": "stage",
      "type": "string"
    },
    "timezone": {
      "default": "Asia/Riyadh",
      "type": "string"
    },
    "concurrency": {
      "default": 2,
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "browser": {
      "default": {},
      "type": "object",
      "properties": {
        "executablePath": {
          "type": "string"
        },
        "args": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "platforms": {
      "default": {
        "desktop": {
          "width": 1440,
          "height": 900,
          "scale": 2
        },
        "mobile": {
          "device": "iPhone 15 Pro",
          "scale": 3
        }
      },
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "isMobile": {
            "type": "boolean"
          },
          "hasTouch": {
            "type": "boolean"
          },
          "userAgent": {
            "type": "string"
          }
        }
      }
    },
    "capture": {
      "default": {},
      "type": "object",
      "properties": {
        "settleMs": {
          "default": 800,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "navigationTimeoutMs": {
          "default": 45000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "networkIdleTimeoutMs": {
          "default": 8000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "actionTimeoutMs": {
          "default": 15000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxFullHeight": {
          "default": 7000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "retries": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "hideScrollbars": {
          "default": true,
          "type": "boolean"
        },
        "freezeTime": {
          "type": "string"
        }
      }
    },
    "variants": {
      "default": {},
      "type": "object",
      "properties": {
        "full": {
          "default": true,
          "type": "boolean"
        },
        "clear": {
          "default": true,
          "type": "boolean"
        },
        "cards": {
          "default": true,
          "type": "boolean"
        },
        "thumbWidth": {
          "default": 720,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "thumbQuality": {
          "default": 78,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "diff": {
      "default": {},
      "type": "object",
      "properties": {
        "threshold": {
          "default": 0.004,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pixelThreshold": {
          "default": 0.1,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "anonymize": {
      "default": {},
      "type": "object",
      "properties": {
        "dictionary": {
          "default": "catalog/anonymize.yaml",
          "type": "string"
        },
        "guard": {
          "default": "strict",
          "type": "string",
          "enum": [
            "strict",
            "warn",
            "off"
          ]
        },
        "observeMutations": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "tagging": {
      "default": {},
      "type": "object",
      "properties": {
        "provider": {
          "default": "claude-code",
          "type": "string",
          "enum": [
            "claude-code",
            "api",
            "off"
          ]
        },
        "batchSize": {
          "default": 4,
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "maxImageEdge": {
          "default": 1568,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "claudePath": {
          "type": "string"
        },
        "claudeModel": {
          "type": "string"
        },
        "model": {
          "default": "claude-opus-5-5",
          "type": "string"
        },
        "effort": {
          "default": "low",
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "concurrency": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "git": {
      "default": {},
      "type": "object",
      "properties": {
        "commit": {
          "default": false,
          "type": "boolean"
        },
        "push": {
          "default": false,
          "type": "boolean"
        },
        "message": {
          "default": "scrn: refresh {date} — {summary}",
          "type": "string"
        }
      }
    },
    "schedule": {
      "default": {},
      "type": "object",
      "properties": {
        "cron": {
          "default": "0 7 * * 1",
          "type": "string"
        }
      }
    },
    "links": {
      "default": {},
      "type": "object",
      "properties": {
        "repoUrl": {
          "type": "string"
        },
        "branch": {
          "default": "main",
          "type": "string"
        }
      }
    }
  }
}
