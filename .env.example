# Скопируй в .env и заполни. .env в git не попадает.

# Автотеги делает Claude Code по твоей подписке — ключ API не нужен.
# Только если в scrn.config.yaml стоит tagging.provider: api:
# ANTHROPIC_API_KEY=

# Figma REST API — экспорт мобильных макетов (шаги с `figma:`). Personal access token: Figma → Settings → Security
FIGMA_TOKEN=

# Если Playwright не может найти свой Chromium (например, в CI или песочнице), укажи путь к бинарнику
# SCRN_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# Окружение по умолчанию (stage | prod | любое из environments в catalog/products/*.yaml)
# SCRN_ENV=stage
